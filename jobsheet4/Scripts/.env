# Application Port
APP_PORT=8080

# Debugger Port
DEBUG_PORT=5005

# Java Options for Debugging
# address=*:5005 allows connections from outside the container
JAVA_OPTS="-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005"

# Database or API keys (if applicable)
DB_URL=jdbc:mysql://db:3306/mydb